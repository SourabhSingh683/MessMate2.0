# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT="3000"

# PostgreSQL Database Configuration
# Standard connection string for external managed PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/messmate?sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/messmate?sslmode=prefer"

# Cloud SQL runtime variables (Injected automatically in AI Studio Cloud SQL runtime):
SQL_HOST="/cloudsql/project:region:instance"
SQL_USER="messmate_app"
SQL_PASSWORD="your-strong-password"
SQL_DB_NAME="messmate"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-admin-password"

